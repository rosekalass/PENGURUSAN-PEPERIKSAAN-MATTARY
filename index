                classId: document.getElementById('student-class').value,
                activeStatus: document.getElementById('student-active').checked,
                updatedAt: Date.now()
            };
            if (!payload.fullName || myKid.length < 6 || !payload.sessionId || !payload.classId) return window.showToast('Lengkapkan semua maklumat murid.', 'warning');
            const duplicate = window.LocalDB.students.find(x => x.id!==studentId && window.normalizeMyKid(x.myKid)===myKid && (x.sessionId||window.DBHelpers.getActiveSession()?.id)===payload.sessionId);
