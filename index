        window.saveSessionForm = async function(e, sessionId = '') {
            e.preventDefault();
            const payload = {
                name: document.getElementById('session-name').value.trim(),
                year: Number(document.getElementById('session-year').value),
                startDate: document.getElementById('session-start').value || '',
                endDate: document.getElementById('session-end').value || '',
                isActive: document.getElementById('session-active').checked,
                status: document.getElementById('session-active').checked ? 'AKTIF' : (sessionId ? (window.LocalDB.sessions.find(x=>x.id===sessionId)?.status || 'ARKIB') : 'AKAN DATANG'),
                updatedAt: Date.now()
            };
            if (!payload.name || !payload.year) return window.showToast('Nama sesi dan tahun diperlukan.', 'warning');
            try {
                if (payload.isActive) {
                    for (const other of window.LocalDB.sessions.filter(x=>x.isActive && x.id!==sessionId)) {
                        await window.updateFirestoreDoc('sessions', other.id, { isActive:false, status:'ARKIB', updatedAt:Date.now() });
                    }
                }
                if (sessionId) await window.updateFirestoreDoc('sessions', sessionId, payload);
                else await window.addFirestoreDoc('sessions', { ...payload, createdAt:Date.now() });
                window.closeModal();
                window.AppState.selectedStudentSessionId = payload.isActive ? null : window.AppState.selectedStudentSessionId;
                window.showToast('Sesi Akademik berjaya disimpan.', 'success');
            } catch(err) { console.error(err); window.showToast(`Gagal menyimpan sesi: ${err.message}`, 'error'); }
        };

