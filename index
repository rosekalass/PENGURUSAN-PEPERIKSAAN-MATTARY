                <p id="confirm-modal-desc" class="text-sm text-gray-500 mb-6">Tindakan ini tidak boleh dipulihkan.</p>
                <div class="flex gap-3 justify-center">
                    <button type="button" onclick="closeConfirmModal()" class="px-5 py-2.5 bg-gray-100 hover:bg-gray-200 text-gray-800 rounded-lg font-bold text-sm transition-colors w-full">Batal</button>
                    <button type="button" id="confirm-modal-btn" class="px-5 py-2.5 bg-mattary hover:bg-mattary-dark text-white rounded-lg font-bold text-sm transition-colors shadow-md w-full">Teruskan</button>
                </div>
            </div>
        </div>
    </div>

    <!-- Print Area -->
    <div id="print-area" class="hidden"></div>

    <script type="module">
        import { initializeApp, getApps, getApp } from "https://www.gstatic.com/firebasejs/11.6.1/firebase-app.js";
        import { getAuth, signInAnonymously } from "https://www.gstatic.com/firebasejs/11.6.1/firebase-auth.js";
        import { getFirestore, collection, doc, setDoc, getDoc, addDoc, updateDoc, deleteDoc, onSnapshot } from "https://www.gstatic.com/firebasejs/11.6.1/firebase-firestore.js";

        const appId = "mattary-sup-dashboard";

        window.FirebaseService = (function() {
            console.log("[FirebaseService] Resolved appId:", appId);
            
            const firebaseConfig = {
                apiKey: "AIzaSyAu0JyxWuxdY8S7xbvo_2JEAwMmaIui8H0",
                authDomain: "mattary-sup-dashboard.firebaseapp.com",
                projectId: "mattary-sup-dashboard",
                storageBucket: "mattary-sup-dashboard.firebasestorage.app",
                messagingSenderId: "482916667846",
                appId: "1:482916667846:web:3c7552af13a3f073f3e2c7",
                measurementId: "G-NTZKDLRF2F"
            };

            let app, db, auth;
            try {
                app = getApps().length ? getApp() : initializeApp(firebaseConfig);
                db = getFirestore(app);
                auth = getAuth(app);
                console.log("[FirebaseService] Firebase & Firestore Initialized successfully.");
            } catch(e) {
                console.error("[FirebaseService] Initialization Error:", e);
            }

            const runDeepConnectionTest = async () => {
                try {
                    const testPath = collection(db, 'artifacts', appId, 'public', 'data', 'connectionTest');
                    const testDocRef = doc(testPath, 'testDoc');
                    await setDoc(testDocRef, { status: "connected", system: "MATTARY", timestamp: Date.now() });
                    const snap = await getDoc(testDocRef);
                    if (!snap.exists() || snap.data().system !== "MATTARY") throw new Error("Read mismatch.");
                    await deleteDoc(testDocRef);
                    console.log("[FirebaseService] Deep Connection Test PASSED!");
                } catch (error) {
                    console.error("[FirebaseService] Deep Connection Test Failed:", error);
                    throw error;
                }
            };

            return { app, db, auth, runDeepConnectionTest };
        })();

        const { db, auth } = window.FirebaseService;

        window.AppState = {
            currentUser: null, 
            role: null, 
            userId: null, 
            mobileSidebarOpen: false,
            currentPath: 'dashboard',
            expandedMenus: new Set(['akademik', 'hafazan', 'pengurusan', 'sistem', 'sistem-pelaporan']),
            isBulkImporting: false,
            selectedStudentSessionId: null
        };

        window.LocalDB = {
            sessions: [], teachers: [], classes: [], students: [], subjects: [],
            assignments: [], academicMarks: [], hafazanMarks: [], pbdRecords: [],
            publications: [], auditLogs: [], assessmentSettings: [], importHistory: [], systemSettings: []
        };

        const collectionsToSync = ['sessions', 'teachers', 'classes', 'students', 'subjects', 'assignments', 'academicMarks', 'hafazanMarks', 'pbdRecords', 'publications', 'auditLogs', 'assessmentSettings', 'importHistory', 'systemSettings'];
        let syncCounter = 0;
        let isSystemReady = false;

        async function initFirebaseData() {
            const loaderText = document.getElementById('loader-text');
            const loaderError = document.getElementById('loader-error');
            const spinner = document.getElementById('loader-spinner');
            const bypassBtn = document.getElementById('loader-bypass-btn');

            try {
                loaderText.innerText = 'Log Masuk Firebase...';
                try {
                    await signInAnonymously(auth);
                } catch (authErr) {
                    console.error("[Firebase Auth Error]", authErr);
                    spinner.className = 'fa-solid fa-triangle-exclamation text-red-500';
                    loaderText.innerText = 'Ralat Pengesahan Firebase';
                    loaderError.innerHTML = `<strong>${authErr.code}</strong><br><span class="text-xs">${authErr.message}</span>`;
                    loaderError.classList.remove('hidden');
                    bypassBtn.classList.remove('hidden');
                    return; 
                }

                if (!auth.currentUser) throw new Error("Current user is null after anonymous login.");

                loaderText.innerText = 'Menguji Sambungan Pangkalan Data...';
                try {
                    await window.FirebaseService.runDeepConnectionTest();
                } catch (dbErr) {
                    console.error("[Firestore Error]", dbErr);
                    spinner.className = 'fa-solid fa-lock text-amber-500';
                    loaderText.innerText = 'Akses Pangkalan Data Disekat';
                    loaderError.innerHTML = `<strong>${dbErr.code || 'permission-denied'}</strong><br><span class="text-xs">Sila periksa Firestore Security Rules.</span>`;
                    loaderError.classList.remove('hidden');
                    bypassBtn.classList.remove('hidden');
                    return;
                }

                loaderText.innerText = 'Menyelaraskan Data...';
                collectionsToSync.forEach(colName => {
                    const colRef = collection(db, 'artifacts', appId, 'public', 'data', colName);
                    onSnapshot(colRef, (snapshot) => {
                        window.LocalDB[colName] = snapshot.docs.map(doc => ({ id: doc.id, ...doc.data() }));
                        if (colName === 'systemSettings' && window.GoogleSheetSync) window.GoogleSheetSync.updateStatusBadge();
                        if (!isSystemReady) {
                            syncCounter++;
                            if (syncCounter === collectionsToSync.length) {
                                isSystemReady = true;
                                window.forceFinishLoading();
                            }
                        } else if (window.AppState.currentUser && !window.AppState.isBulkImporting) {
                            window.renderContent(window.AppState.currentPath);
                        }
                    }, (error) => { console.error(`[Sync Error] ${colName}:`, error); });
                });
            } catch(e) {
                console.error("[Fatal Init Error]:", e);
                spinner.className = 'fa-solid fa-bomb text-red-500';
                loaderText.innerText = 'Ralat Sistem Kritikal'; loaderError.innerHTML = `${e.message}`; loaderError.classList.remove('hidden');
                bypassBtn.classList.remove('hidden');
            }
        }

        window.forceFinishLoading = function() {
            const loader = document.getElementById('system-loader');
            loader.classList.add('opacity-0');
            setTimeout(() => {
                loader.classList.add('hidden');
                document.getElementById('login-container').classList.remove('hidden');
            }, 500);
        };

        window.addEventListener('DOMContentLoaded', () => { if (typeof initFirebaseData === 'function') initFirebaseData(); });

        function checkAuthBeforeWrite() {
            if (!auth || !auth.currentUser) {
                window.showToast("Ralat Kritikal: Firebase Authentication belum aktif. Tindakan disekat.", "error");
                throw new Error("auth.currentUser is null.");
            }
        }

        window.getColRef = (colName) => collection(db, 'artifacts', appId, 'public', 'data', colName);
        window.getDocRef = (colName, docId) => doc(db, 'artifacts', appId, 'public', 'data', colName, docId);
        
        window.addFirestoreDoc = async (colName, data) => {
            checkAuthBeforeWrite();
            const ref = await addDoc(window.getColRef(colName), data);
            if (window.GoogleSheetSync) window.GoogleSheetSync.queueChange('UPSERT', colName, ref.id, { id: ref.id, ...data });
            return ref;
        };
        window.updateFirestoreDoc = async (colName, docId, data) => {
            checkAuthBeforeWrite();
            const result = await updateDoc(window.getDocRef(colName, docId), data);
            const current = (window.LocalDB[colName] || []).find(x => x.id === docId) || {};
            if (window.GoogleSheetSync) window.GoogleSheetSync.queueChange('UPSERT', colName, docId, { ...current, ...data, id: docId });
            return result;
        };
        window.setFirestoreDoc = async (colName, docId, data, options = { merge: true }) => {
            checkAuthBeforeWrite();
            const result = await setDoc(window.getDocRef(colName, docId), data, options);
            const current = (window.LocalDB[colName] || []).find(x => x.id === docId) || {};
            if (window.GoogleSheetSync) window.GoogleSheetSync.queueChange('UPSERT', colName, docId, { ...current, ...data, id: docId });
            return result;
        };
        window.deleteFirestoreDoc = async (colName, docId) => {
            checkAuthBeforeWrite();
            const result = await deleteDoc(window.getDocRef(colName, docId));
            if (window.GoogleSheetSync) window.GoogleSheetSync.queueChange('DELETE', colName, docId, null);
            return result;
        };

        window.normalizeMyKid = (v) => (v == null ? "" : String(v).trim().replace(/\D/g, ""));
        window.normalizeMyKad = (v) => (v == null ? "" : String(v).trim().replace(/\D/g, ""));

        window.DBHelpers = {
            getActiveSession: () => window.LocalDB.sessions.find(s => s.isActive),
            getClass: (id) => window.LocalDB.classes.find(c => c.id === id),
            formatClassName: (cls) => cls ? String(cls.name || '').trim().toUpperCase() : '-',
            getSortedTeachers: (teachers = window.LocalDB.teachers) => [...teachers].sort((a,b) => String(a.fullName||'').localeCompare(String(b.fullName||''), 'ms', { sensitivity:'base' })),
            getStudentsForSession: (sessionId) => {
                const active = window.LocalDB.sessions.find(s => s.isActive);
                return window.LocalDB.students.filter(st => {
                    if (st.sessionId) return st.sessionId === sessionId;
                    // Legacy records without sessionId are treated as belonging to the current active session only.
                    return !!active && active.id === sessionId;
                });
            },
            getStudentForSession: (myKid, sessionId) => window.DBHelpers.getStudentsForSession(sessionId).find(s => s.myKid === myKid),
            getSortedClasses: (classes = window.LocalDB.classes) => {
                return [...classes].sort((a, b) => {
                    const yearA = Number(a.yearLevel) || 0; const yearB = Number(b.yearLevel) || 0;
                    if (yearA !== yearB) return yearA - yearB;
                    return String(a.name || "").localeCompare(String(b.name || ""), "ms", { numeric: true, sensitivity: "base" });
                });
            },
            getAssignedClassesForTeacher: (teacherId, sessionId) => {
                const myAssg = window.LocalDB.assignments.filter(a => a.teacherId === teacherId && a.sessionId === sessionId);
                const classIds = [...new Set(myAssg.map(a => a.classId))];
                return window.DBHelpers.getSortedClasses(window.LocalDB.classes.filter(c => classIds.includes(c.id)));
            },
            getAssignedSubjectsForClass: (teacherId, classId, sessionId) => {
                const myAssg = window.LocalDB.assignments.filter(a => a.teacherId === teacherId && a.classId === classId && a.sessionId === sessionId);
                const subjectIds = myAssg.map(a => a.subjectId);
                return window.LocalDB.subjects.filter(s => subjectIds.includes(s.id)).sort((a,b) => a.name.localeCompare(b.name));
            },
            isPublished: (examType, sessionId) => {
                const pub = window.LocalDB.publications.find(p => p.examType === examType && p.sessionId === sessionId);
                return pub && pub.status === 'PUBLISHED';
            }
        };

        window.DEFAULT_GRADE_SCALE = [
            { grade:'A', min:82, max:100, desc:'Cemerlang' },
            { grade:'B', min:66, max:81.99, desc:'Kepujian' },
            { grade:'C', min:50, max:65.99, desc:'Baik' },
            { grade:'D', min:35, max:49.99, desc:'Memuaskan' },
            { grade:'E', min:20, max:34.99, desc:'Mencapai Tahap Minimum' },
            { grade:'F', min:0, max:19.99, desc:'Belum Mencapai Tahap Minimum' }
        ];
        window.getGradeScale = function() {
            const cfg = (window.LocalDB.systemSettings || []).find(x => x.id === 'gradeSettings');
            const rows = Array.isArray(cfg?.ranges) && cfg.ranges.length === 6 ? cfg.ranges : window.DEFAULT_GRADE_SCALE;
            return rows.map(x => ({ grade:String(x.grade||'').toUpperCase(), min:Number(x.min), max:Number(x.max), desc:String(x.desc||'') }))
                .filter(x => x.grade && Number.isFinite(x.min) && Number.isFinite(x.max))
                .sort((a,b) => b.min - a.min);
        };
        window.getGradeFromPercentage = (pct) => {
            if (pct === null || pct === undefined || isNaN(pct) || pct === '') return { grade:'-', desc:'-' };
            const p = Number(pct);
            if (p < 0 || p > 100) return { grade:'-', desc:'-' };
            const row = window.getGradeScale().find(x => p >= x.min && p <= x.max + 0.0001);
            return row ? { grade:row.grade, desc:row.desc } : { grade:'-', desc:'-' };
        };

        window.GENERIC_PBD_DESCRIPTIONS = {
            'TP1': 'Tahu perkara asas / kemahiran asas.',
            'TP2': 'Menunjukkan kefahaman dan dapat menjelaskan pembelajaran.',
            'TP3': 'Menggunakan pengetahuan untuk melaksanakan kemahiran/tugasan dalam suatu situasi.',
            'TP4': 'Menggunakan pengetahuan dan melaksanakan kemahiran secara bersistematik/analitik.',
            'TP5': 'Mengaplikasikan pengetahuan/kemahiran dalam situasi baharu secara konsisten, bersistematik dan bersikap positif.',
            'TP6': 'Mengaplikasikan pengetahuan dan kemahiran dalam situasi baharu secara analitik, sistematik, kreatif dan inovatif serta boleh dicontohi.'
        };
        window.getPBDDescription = (tp, subjectId = '', yearLevel = '') => {
            const subject = subjectId ? window.LocalDB.subjects.find(s => s.id === subjectId) : null;
            const statements = subject?.pbdStatements || {};
            const yearKey = yearLevel ? `Y${Number(yearLevel)}` : '';
            const yearStatements = yearKey && statements[yearKey] && typeof statements[yearKey] === 'object' ? statements[yearKey] : null;
            return (yearStatements && yearStatements[tp]) || statements[tp] || window.GENERIC_PBD_DESCRIPTIONS[tp] || '-';
        };
        
        window.getPBDIndicator = (tp) => {
            if (['TP1', 'TP2'].includes(tp)) return '<span class="text-red-600 font-bold text-xs"><i class="fa-solid fa-triangle-exclamation mr-1"></i>PERLU TINDAKAN SUSULAN</span>';
            if (tp === 'TP3') return '<span class="text-amber-500 font-bold text-xs"><i class="fa-solid fa-check mr-1"></i>MENCAPAI TAHAP MINIMUM</span>';
            if (['TP4', 'TP5', 'TP6'].includes(tp)) return '<span class="text-emerald-600 font-bold text-xs"><i class="fa-solid fa-star mr-1"></i>MELEBIHI TAHAP MINIMUM</span>';
            return '-';
        };

        // ------------------------------------------------------------------
        // Google Sheets mirror sync
        // Firestore remains the authoritative database. Google Sheets is a
        // live operational/reporting mirror via a Google Apps Script Web App.
        // ------------------------------------------------------------------
        window.GoogleSheetSync = (function() {
            const SYNC_COLLECTIONS = [
                'sessions','teachers','classes','students','subjects','assignments',
                'academicMarks','hafazanMarks','pbdRecords','publications',
                'auditLogs','assessmentSettings','importHistory','systemSettings'
            ];
            let queue = Promise.resolve();
            let analysisTimer = null;
            let state = 'OFF';
            let lastMessage = 'Google Sheets belum dikonfigurasi';
            let tempConfig = null;

            function getConfig() {
                if (tempConfig) return tempConfig;
                const cfg = (window.LocalDB.systemSettings || []).find(x => x.id === 'googleSheetsSync') || {};
                return {
                    enabled: !!cfg.enabled,
                    autoSync: cfg.autoSync !== false,
                    endpoint: String(cfg.endpoint || '').trim(),
                    accessKey: String(cfg.accessKey || '').trim(),
                    spreadsheetUrl: String(cfg.spreadsheetUrl || 'https://docs.google.com/spreadsheets/d/16TtxB0O2qbXfNZ-fY2JgbrA81TZR9snfzi7ZZsPgss8/edit').trim(),
                    updatedAt: cfg.updatedAt || null
                };
            }

            function setTempConfig(cfg) { tempConfig = { ...getConfig(), ...cfg }; updateStatusBadge(); }
            function clearTempConfig() { tempConfig = null; updateStatusBadge(); }
            function ready(cfg = getConfig()) { return !!(cfg.enabled && /^https:\/\//i.test(cfg.endpoint)); }

            function setState(next, message) {
                state = next;
                lastMessage = message || lastMessage;
                updateStatusBadge();
            }

            function updateStatusBadge() {
                const dot = document.getElementById('sheet-sync-dot');
                const label = document.getElementById('sheet-sync-label');
                const btn = document.getElementById('sheet-sync-status');
                if (!dot || !label || !btn) return;
                const cfg = getConfig();
                let dotClass = 'bg-gray-400', labelText = 'SHEETS OFF', btnClass = 'bg-gray-50 border-gray-200 text-gray-600';
                if (ready(cfg)) {
                    if (state === 'SYNCING') { dotClass = 'bg-amber-400 animate-pulse'; labelText = 'SHEETS SYNC'; btnClass = 'bg-amber-50 border-amber-200 text-amber-700'; }
                    else if (state === 'ERROR') { dotClass = 'bg-red-500'; labelText = 'SHEETS ERROR'; btnClass = 'bg-red-50 border-red-200 text-red-700'; }
                    else { dotClass = 'bg-emerald-500'; labelText = 'SHEETS READY'; btnClass = 'bg-emerald-50 border-emerald-200 text-emerald-700'; }
                }
                dot.className = `sheet-sync-dot ${dotClass}`;
                label.textContent = labelText;
                btn.className = `flex items-center gap-2 px-3 py-1.5 rounded-full border ${btnClass}`;
                btn.title = `${labelText}: ${lastMessage}`;
            }

            async function post(payload, overrideConfig = null) {
                const cfg = overrideConfig ? { ...getConfig(), ...overrideConfig } : getConfig();
                if (!ready(cfg)) throw new Error('Google Sheets Sync belum dikonfigurasi.');
                setState('SYNCING', 'Menyelaraskan data...');
                const response = await fetch(cfg.endpoint, {
                    method: 'POST',
                    headers: { 'Content-Type': 'text/plain;charset=utf-8' },
                    body: JSON.stringify({
                        system: 'MATTARY_SUP',
                        accessKey: cfg.accessKey || '',
                        sentAt: new Date().toISOString(),
                        ...payload
                    })
                });
                if (!response.ok) throw new Error(`HTTP ${response.status}`);
                let result = {};
                try { result = await response.json(); } catch (_) { result = { ok: true }; }
                if (result && result.ok === false) throw new Error(result.error || 'Google Sheets menolak permintaan.');
                setState('READY', `Sync berjaya ${new Date().toLocaleTimeString('ms-MY')}`);
                return result;
            }

            function sanitizeCollectionData(name, rows) {
                return (rows || []).filter(row => name !== 'systemSettings' || row.settingKey !== 'PBD_TEMPLATE_ASSET').map(row => ({ ...row }));
            }

            function buildAnalysisSummary() {
                const rows = [];
                const gradeKeys = ['A','B','C','D','E','F'];
                function aggregateMarks(sourceName, category, data) {
                    const groups = new Map();
                    (data || []).forEach(m => {
                        const key = [m.sessionId||'', m.examType||'', m.classId||'', m.subjectId||''].join('|');
                        if (!groups.has(key)) groups.set(key, []);
                        groups.get(key).push(m);
                    });
                    for (const [key, items] of groups.entries()) {
                        const [sessionId, examType, classId, subjectId] = key.split('|');
                        const valid = items.filter(x => x.status === 'HADIR' && x.percentage !== null && x.percentage !== undefined && !isNaN(Number(x.percentage)));
                        const pcts = valid.map(x => Number(x.percentage));
                        const gradeCounts = Object.fromEntries(gradeKeys.map(g => [g, valid.filter(x => (x.grade || window.getGradeFromPercentage(x.percentage).grade) === g).length]));
                        rows.push({
                            analysisType: 'MARKAH', source: sourceName, category, sessionId, examType, classId,
                            className: window.DBHelpers.formatClassName(window.DBHelpers.getClass(classId)), subjectId,
                            subjectName: window.LocalDB.subjects.find(s=>s.id===subjectId)?.name || subjectId,
                            records: items.length, assessed: valid.length,
                            average: pcts.length ? Number((pcts.reduce((a,b)=>a+b,0)/pcts.length).toFixed(2)) : '',
                            highest: pcts.length ? Math.max(...pcts) : '', lowest: pcts.length ? Math.min(...pcts) : '',
                            TH: items.filter(x=>x.status==='TH').length, TD: items.filter(x=>x.status==='TD').length,
                            ...gradeCounts
                        });
                    }
                }
                aggregateMarks('academicMarks','AKADEMIK', window.LocalDB.academicMarks);
                aggregateMarks('hafazanMarks','HAFAZAN', window.LocalDB.hafazanMarks);

                const pbdGroups = new Map();
                (window.LocalDB.pbdRecords || []).forEach(r => {
                    const key = [r.sessionId||'', r.category||'', r.classId||'', r.subjectId||''].join('|');
                    if (!pbdGroups.has(key)) pbdGroups.set(key, []);
                    pbdGroups.get(key).push(r);
                });
                for (const [key, items] of pbdGroups.entries()) {
                    const [sessionId, category, classId, subjectId] = key.split('|');
                    const row = {
                        analysisType:'PBD', source:'pbdRecords', category, sessionId, examType:'PBD', classId,
                        className: window.DBHelpers.formatClassName(window.DBHelpers.getClass(classId)), subjectId,
                        subjectName: window.LocalDB.subjects.find(s=>s.id===subjectId)?.name || subjectId,
                        records: items.length
                    };
                    for (let i=1;i<=6;i++) row[`TP${i}`] = items.filter(x=>x.tp===`TP${i}`).length;
                    rows.push(row);
                }
                return rows;
            }

            async function fullSync(options = {}) {
                const cfg = options.config || getConfig();
                if (!ready(cfg)) {
                    if (!options.silent) window.showToast('Sila konfigurasi Google Sheets Sync dahulu.', 'warning');
                    return false;
                }
                const snapshot = {};
                SYNC_COLLECTIONS.forEach(name => snapshot[name] = sanitizeCollectionData(name, window.LocalDB[name]));
                try {
                    await post({ action:'FULL_SYNC', snapshot, analysis: buildAnalysisSummary() }, cfg);
                    if (!options.silent) window.showToast('Semua data berjaya diselaraskan ke Google Sheets.', 'success');
                    return true;
                } catch (e) {
                    console.error('[GoogleSheetSync] Full sync failed', e);
                    setState('ERROR', e.message);
                    if (!options.silent) window.showToast(`Google Sheets Sync gagal: ${e.message}`, 'error');
                    return false;
                }
            }

            function scheduleAnalysisSync() {
                clearTimeout(analysisTimer);
                analysisTimer = setTimeout(() => {
                    const cfg = getConfig();
                    if (!ready(cfg) || !cfg.autoSync) return;
                    queue = queue.then(() => post({ action:'ANALYSIS_SYNC', analysis: buildAnalysisSummary() })).catch(e => {
                        console.error('[GoogleSheetSync] Analysis sync failed', e);
                        setState('ERROR', e.message);
                    });
                }, 1800);
            }

            function queueChange(action, collectionName, id, data) {
                if (!SYNC_COLLECTIONS.includes(collectionName) || (collectionName === 'systemSettings' && (data?.settingKey === 'PBD_TEMPLATE_ASSET' || String(id).startsWith('pbdTemplate_')))) return;
                const cfg = getConfig();
                if (!ready(cfg) || !cfg.autoSync) return;
                queue = queue.then(() => post({ action, collection: collectionName, id, data })).catch(e => {
                    console.error('[GoogleSheetSync] Incremental sync failed', e);
                    setState('ERROR', e.message);
                });
                if (['academicMarks','hafazanMarks','pbdRecords'].includes(collectionName)) scheduleAnalysisSync();
            }

            async function testConnection(overrideConfig = null) {
                try {
                    const result = await post({ action:'PING' }, overrideConfig);
                    setState('READY', result.message || 'Sambungan Google Sheets berjaya.');
                    return { ok:true, result };
                } catch (e) {
                    setState('ERROR', e.message);
                    return { ok:false, error:e };
                }
            }

            function scheduleFullSync(delay = 1500) {
                setTimeout(() => {
                    const cfg = getConfig();
                    if (ready(cfg) && cfg.autoSync && window.AppState.role === 'ADMIN') fullSync({ silent:true });
                }, delay);
            }

            return { getConfig, setTempConfig, clearTempConfig, ready, post, fullSync, queueChange, testConnection, buildAnalysisSummary, updateStatusBadge, scheduleFullSync };
        })();

        window.showToast = function(message, type = 'success') {
            const container = document.getElementById('toast-container'); const toast = document.createElement('div');
            const bg = type === 'success' ? 'bg-white border-l-4 border-emerald-500' : (type === 'warning' ? 'bg-white border-l-4 border-amber-500' : 'bg-white border-l-4 border-red-500');
