        window.generateGuruKelasReport = function(sessionId) {
            const { examType, classId } = window.TeacherReportState;
            const cls = window.DBHelpers.getClass(classId);
            if (!cls) return `<div class="bg-white p-12 text-center rounded-2xl border border-dashed text-gray-500">Sila pilih kelas.</div>`;

            // Validate UPAIM for non-Year 6
            if (examType === 'UPAIM' && Number(cls.yearLevel) !== 6) {
                return `<div class="bg-amber-50 p-12 text-center rounded-2xl border border-amber-200 text-amber-700 font-bold"><i class="fa-solid fa-triangle-exclamation text-4xl mb-4 block text-amber-400"></i> UPAIM dikhususkan untuk Tahun 6 sahaja. Kelas ini adalah Tahun ${cls.yearLevel}.</div>`;
            }

            const isHafazan = ['UPSEH', 'UASEH', 'UPAIM'].includes(examType);
            const colName = isHafazan ? 'hafazanMarks' : 'academicMarks';
            const category = isHafazan ? 'HAFAZAN' : 'AKADEMIK';

            // Get students in this specific class
            const students = window.DBHelpers.getStudentsForSession(sessionId).filter(s => s.classId === classId && s.activeStatus).sort((a,b)=>a.fullName.localeCompare(b.fullName));
            
            // Get applicable subjects for this class's year level and requested category
            const applicableSubjects = window.LocalDB.subjects.filter(sub => sub.status && sub.type === category && (sub.yearLevel == 'SEMUA' || sub.yearLevel == cls.yearLevel)).sort((a,b)=>a.name.localeCompare(b.name));

            // Fetch all marks for this class, session, and exam
            const allMarks = window.LocalDB[colName].filter(m => m.sessionId === sessionId && m.examType === examType && m.classId === classId);

            if (students.length === 0) return `<div class="bg-white p-12 text-center rounded-2xl border border-dashed text-gray-500">Tiada murid aktif berdaftar di dalam kelas ini.</div>`;

            // Build student data rows
            const studentData = students.map(student => {
                const row = { student, subjects: {}, totalPercentage: 0, validSubjectCount: 0, grades: { A:0, B:0, C:0, D:0, E:0, F:0 }, isComplete: true };
                
                applicableSubjects.forEach(sub => {
                    const markRec = allMarks.find(m => m.myKid === student.myKid && m.subjectId === sub.id);
                    if (markRec) {
                        row.subjects[sub.id] = markRec;
                        if (markRec.status === 'HADIR' && markRec.percentage !== null) {
                            row.totalPercentage += Number(markRec.percentage);
                            row.validSubjectCount++;
                            if(markRec.grade && row.grades[markRec.grade] !== undefined) row.grades[markRec.grade]++;
                        } else {
                            // Missing or not attended counts as incomplete for average ranking
                            row.isComplete = false; 
                        }
                    } else {
                        row.subjects[sub.id] = { status: 'BELUM DIISI' };
                        row.isComplete = false;
                    }
                });

                // Calculate internal average
                if (row.validSubjectCount > 0) {
                    row.averagePercentage = row.totalPercentage / row.validSubjectCount;
                    row.averageGradeObj = window.getGradeFromPercentage(row.averagePercentage);
                } else {
                    row.averagePercentage = null;
                    row.averageGradeObj = { grade: '-', desc: '-' };
                }

                return row;
            });

            // Calculate Rankings (Internal MATTARY Only) - only rank complete students
            const completeStudents = studentData.filter(r => r.isComplete && r.averagePercentage !== null);
            completeStudents.sort((a, b) => b.averagePercentage - a.averagePercentage); // Descending

            let currentRank = 1;
            for (let i = 0; i < completeStudents.length; i++) {
                if (i > 0 && completeStudents[i].averagePercentage === completeStudents[i-1].averagePercentage) {
                    completeStudents[i].rank = completeStudents[i-1].rank; // Tie
                } else {
                    completeStudents[i].rank = currentRank;
                }
                currentRank++;
            }

            // Aggregate Class KPI
            let totalA=0, totalB=0, totalC=0, totalD=0, totalE=0, totalF=0;
            let highestAvg = 0, lowestAvg = 100, classTotalAvg = 0, classValidAvgCount = 0;

            completeStudents.forEach(r => {
                totalA += r.grades.A; totalB += r.grades.B; totalC += r.grades.C;
                totalD += r.grades.D; totalE += r.grades.E; totalF += r.grades.F;
                
                if (r.averagePercentage > highestAvg) highestAvg = r.averagePercentage;
                if (r.averagePercentage < lowestAvg) lowestAvg = r.averagePercentage;
                
                classTotalAvg += r.averagePercentage;
                classValidAvgCount++;
            });

            const classAverage = classValidAvgCount > 0 ? (classTotalAvg / classValidAvgCount).toFixed(1) : 0;

            let html = `
            <div class="print-bg-gray bg-white rounded-2xl shadow-sm border border-gray-200 p-6">
                <div class="text-center mb-8 border-b pb-4">
                    <h1 class="text-2xl font-black uppercase tracking-widest text-gray-800">LAPORAN PRESTASI KELAS</h1>
                    <h2 class="text-lg font-bold text-mattary uppercase mt-1">${cls.name}</h2>
                    <p class="text-sm font-bold text-gray-600 uppercase mt-2">SESI: ${window.DBHelpers.getActiveSession()?.name} | PEPERIKSAAN: ${examType}</p>
                </div>

                <!-- Class KPI -->
                <div class="grid grid-cols-2 md:grid-cols-4 lg:grid-cols-8 gap-3 mb-8">
                    <div class="bg-blue-50 p-3 rounded-lg text-center border border-blue-100"><p class="text-[9px] font-bold text-blue-500 uppercase">Jumlah Murid</p><p class="text-xl font-black text-blue-800">${students.length}</p></div>
                    <div class="bg-indigo-50 p-3 rounded-lg text-center border border-indigo-100"><p class="text-[9px] font-bold text-indigo-500 uppercase">Purata Kelas</p><p class="text-xl font-black text-indigo-800">${classAverage}%</p></div>
                    <div class="bg-teal-50 p-3 rounded-lg text-center border border-teal-100"><p class="text-[9px] font-bold text-teal-500 uppercase">Purata Tertinggi</p><p class="text-xl font-black text-teal-800">${highestAvg.toFixed(1)}%</p></div>
                    <div class="bg-rose-50 p-3 rounded-lg text-center border border-rose-100"><p class="text-[9px] font-bold text-rose-500 uppercase">Purata Terendah</p><p class="text-xl font-black text-rose-800">${classValidAvgCount > 0 ? lowestAvg.toFixed(1) : 0}%</p></div>
                    
                    <div class="bg-green-50 p-3 rounded-lg text-center border border-green-200"><p class="text-[9px] font-bold text-green-600 uppercase">Jumlah A</p><p class="text-xl font-black text-green-800">${totalA}</p></div>
                    <div class="bg-emerald-50 p-3 rounded-lg text-center border border-emerald-200"><p class="text-[9px] font-bold text-emerald-600 uppercase">Jumlah B</p><p class="text-xl font-black text-emerald-800">${totalB}</p></div>
                    <div class="bg-yellow-50 p-3 rounded-lg text-center border border-yellow-200"><p class="text-[9px] font-bold text-yellow-600 uppercase">Jumlah C</p><p class="text-xl font-black text-yellow-800">${totalC}</p></div>
                    <div class="bg-red-50 p-3 rounded-lg text-center border border-red-200"><p class="text-[9px] font-bold text-red-600 uppercase">Jumlah F</p><p class="text-xl font-black text-red-800">${totalF}</p></div>
                </div>

                <!-- Detailed Table -->
                <div class="overflow-x-auto border rounded-lg">
                    <table class="w-full text-sm text-left" id="guru-kelas-table">
                        <thead class="bg-gray-100 text-[10px] uppercase text-gray-700">
                            <tr>
                                <th class="px-4 py-3 border-r" rowspan="2">Bil</th>
                                <th class="px-4 py-3 border-r min-w-[200px]" rowspan="2">Nama Murid</th>
                                <th class="px-4 py-2 border-b border-r text-center bg-blue-50/50" colspan="${applicableSubjects.length}">Keputusan Mengikut Subjek</th>
                                <th class="px-4 py-2 border-b text-center bg-indigo-50/50" colspan="4">Analisis Dalaman MATTARY *</th>
                            </tr>
                            <tr>
                                ${applicableSubjects.map(sub => `<th class="px-2 py-2 border-r text-center whitespace-nowrap bg-blue-50/30" title="${sub.name}">${sub.code || sub.name.substring(0,4)}</th>`).join('')}
                                <th class="px-2 py-2 border-r text-center bg-indigo-50/30" title="Purata Peratusan">Purata %</th>
                                <th class="px-2 py-2 border-r text-center bg-indigo-50/30" title="Gred Purata Dalaman">Gred Purata</th>
                                <th class="px-2 py-2 border-r text-center bg-indigo-50/30" title="Jumlah A">A</th>
                                <th class="px-2 py-2 text-center bg-indigo-50/30" title="Kedudukan Dalaman Kelas">Ked. Kelas</th>
                            </tr>
                        </thead>
                        <tbody class="divide-y divide-gray-200">
                            ${studentData.map((row, idx) => `
                                <tr class="hover:bg-gray-50">
                                    <td class="px-4 py-2 border-r text-center font-bold text-gray-500">${idx + 1}</td>
                                    <td class="px-4 py-2 border-r">
                                        <p class="font-bold text-gray-800 uppercase text-xs">${row.student.fullName}</p>
                                    </td>
                                    
                                    <!-- Subjects -->
                                    ${applicableSubjects.map(sub => {
                                        const res = row.subjects[sub.id];
                                        let display = '-';
                                        let style = 'text-gray-400';
                                        
                                        if (res && res.status === 'HADIR' && res.percentage !== null) {
                                            display = `${Number(res.percentage).toFixed(0)}% | <span class="font-bold ${res.grade==='A'?'text-emerald-600':(res.grade==='F'?'text-red-600':'')}">${res.grade}</span>`;
                                            style = 'text-gray-800';
                                        } else if (res && res.status !== 'HADIR' && res.status !== 'BELUM DIISI') {
                                            display = `<span class="text-[9px] bg-red-100 text-red-600 px-1 py-0.5 rounded">${res.status}</span>`;
                                        }

                                        return `<td class="px-2 py-2 border-r text-center text-xs whitespace-nowrap ${style}">${display}</td>`;
                                    }).join('')}

                                    <!-- Analytics -->
                                    <td class="px-2 py-2 border-r text-center font-mono font-bold text-indigo-700 bg-indigo-50/10">
                                        ${row.averagePercentage !== null ? row.averagePercentage.toFixed(1)+'%' : '<span class="text-[9px] text-amber-600">TIDAK LENGKAP</span>'}
                                    </td>
                                    <td class="px-2 py-2 border-r text-center font-bold text-lg ${row.averageGradeObj.grade==='A'?'text-emerald-600':(row.averageGradeObj.grade==='F'?'text-red-600':'text-gray-700')} bg-indigo-50/10">
                                        ${row.averageGradeObj.grade}
                                    </td>
                                    <td class="px-2 py-2 border-r text-center font-bold text-green-700 bg-indigo-50/10">${row.grades.A}</td>
                                    <td class="px-2 py-2 text-center font-black text-gray-800 bg-indigo-50/10">
                                        ${row.rank ? `${row.rank} / ${completeStudents.length}` : '-'}
                                    </td>
                                </tr>
                            `).join('')}
                        </tbody>
                    </table>
                </div>
                <div class="mt-4 text-[10px] text-gray-500 italic">
                    * Analisis Dalaman MATTARY: Pengiraan Purata Peratus, Gred Purata dan Kedudukan Kelas adalah analisis dalaman sekolah dan bukan merupakan pelaporan rasmi KPM UASA. Kedudukan hanya dikira bagi murid yang mempunyai markah lengkap bagi semua subjek.
                </div>
            </div>`;

            return html;
        };

        window.downloadStandardMarkTemplate = function() {
            const active = window.DBHelpers.getActiveSession();
            const { classId, subjectId, examType, category } = window.AssessmentState;
            if (!active || !classId || !subjectId) return window.showToast('Pilih kelas dan subjek dahulu sebelum memuat turun template markah.', 'warning');
            if (typeof XLSX === 'undefined') return window.showToast('Library Excel belum tersedia.', 'error');
            const cls = window.DBHelpers.getClass(classId); const subject = window.LocalDB.subjects.find(s=>s.id===subjectId);
            const students = window.DBHelpers.getStudentsForSession(active.id).filter(x=>x.classId===classId && x.activeStatus!==false).sort((a,b)=>String(a.fullName||'').localeCompare(String(b.fullName||''),'ms',{sensitivity:'base'}));
            const rows = [
                [`SUP PEPERIKSAAN MATTARY — TEMPLATE MARKAH ${examType}`],
                [`SESI: ${active.name}`, `KELAS: ${window.DBHelpers.formatClassName(cls)}`, `SUBJEK: ${subject?.name||''}`, `KATEGORI: ${category}`],
                [],
                ['BIL','NAMA MURID','KEHADIRAN','MARKAH (%)','GRED','CATATAN GURU']
            ];
            students.forEach((st,i)=>rows.push([i+1, st.fullName, 'HADIR', '', '', '']));
            const ws = XLSX.utils.aoa_to_sheet(rows);
            const gradeScale = window.getGradeScale();
            students.forEach((_,idx)=>{ const r=idx+5; const nested=gradeScale.map((g,i)=>`IF(D${r}>=${g.min},\"${g.grade}\",${i===gradeScale.length-1?'\"-\"':''}`).join('') + ')'.repeat(gradeScale.length); ws[`E${r}`] = { t:'s', f:`IF(D${r}=\"\",\"\",IF(C${r}<>\"HADIR\",C${r},${nested}))` }; });
            ws['!cols']=[{wch:7},{wch:38},{wch:14},{wch:14},{wch:10},{wch:30}];
            ws['!merges']=[XLSX.utils.decode_range('A1:F1')];
            const guide = XLSX.utils.aoa_to_sheet([
                ['PANDUAN TEMPLATE MARKAH MATTARY'],
                ['Format standard','BIL | NAMA MURID | KEHADIRAN | MARKAH (%) | GRED | CATATAN GURU'],
                ['Kehadiran','Gunakan HADIR, TH atau TD.'],
                ['Markah','Masukkan 0 hingga 100 bagi murid HADIR.'],
                ['Gred','Dijana berdasarkan Tetapan Gred semasa dalam sistem.'],
                ['Nota','Jangan ubah nama murid atau susunan kelas jika template akan dirujuk semula.']
            ]); guide['!cols']=[{wch:20},{wch:80}];
            const wb = XLSX.utils.book_new(); XLSX.utils.book_append_sheet(wb,ws,'MARKAH'); XLSX.utils.book_append_sheet(wb,guide,'PANDUAN');
            const safe = String(subject?.code||subject?.name||'SUBJEK').replace(/[^A-Za-z0-9_-]+/g,'_');
            XLSX.writeFile(wb,`TEMPLATE_MARKAH_${examType}_${safe}_${window.DBHelpers.formatClassName(cls).replace(/\s+/g,'_')}_${active.name}.xlsx`);
        };

        window.PBDState = { classId: '', subjectId: '', saving: false };
        window.CurrentPBD = {};

        window.handlePBDClassChange = (classId) => { window.PBDState.classId = classId; window.PBDState.subjectId = ''; window.renderContent(window.AppState.currentPath); };
        window.handlePBDSubjectChange = (subjectId) => { window.PBDState.subjectId = subjectId; window.renderContent(window.AppState.currentPath); };

        window.handlePBDInput = (myKid, field, value) => {
            if(!window.CurrentPBD[myKid]) return;
            window.CurrentPBD[myKid][field] = value;
            if (field === 'tp') {
                document.getElementById(`tafsiran-${myKid}`).innerText = window.getPBDDescription(value);
                document.getElementById(`ind-${myKid}`).innerHTML = window.getPBDIndicator(value);
            }
        };

        window.saveAllPBD = async () => {
            const actSession = window.DBHelpers.getActiveSession(); if (!actSession) return window.showToast('Sesi tidak aktif.', 'error');
            const { classId, subjectId } = window.PBDState;
            const category = window.AppState.currentPath.split('-')[0].toUpperCase();
            if (!classId || !subjectId) return window.showToast('Pilih kelas dan subjek dahulu.', 'warning');

            window.PBDState.saving = true;
            const btn = document.getElementById('btn-save-pbd'); if(btn) btn.innerHTML = '<i class="fa-solid fa-spinner fa-spin"></i> Menyimpan...';
            
            try {
                let addCount = 0; let updateCount = 0;
                for (const [myKid, data] of Object.entries(window.CurrentPBD)) {
                    const existing = window.LocalDB.pbdRecords.find(m => m.myKid === myKid && m.classId === classId && m.subjectId === subjectId && m.category === category && m.sessionId === actSession.id);
                    if (!data.tp && !existing) continue;
                    const payload = { myKid, subjectId, sessionId: actSession.id, classId, category, tp: data.tp, ulasan: data.ulasan, updatedAt: Date.now() };
                    if (existing) { await window.updateFirestoreDoc('pbdRecords', existing.id, payload); updateCount++; }
                    else { await window.addFirestoreDoc('pbdRecords', { ...payload, createdAt: Date.now() }); addCount++; }
                }
                window.showToast(`Berjaya! ${addCount} ditambah, ${updateCount} dikemaskini.`, 'success');
            } catch (err) {
                console.error("[Save PBD Error]", err); window.showToast('Ralat menyimpan PBD.', 'error');
            } finally {
                window.PBDState.saving = false; if(btn) btn.innerHTML = '<i class="fa-solid fa-cloud-arrow-up"></i> Simpan Semua';
                window.renderContent(window.AppState.currentPath);
            }
        };

