an, pilih lajur bagi peringkat yang hendak direkodkan. TP keseluruhan tidak dikira secara automatik daripada bidang.</p><div class="pbd-fields-grid">${cols.filter(col=>![d.nameCol,d.kidCol,d.genderCol,d.overallCol,d.ulasanCol].includes(col)).map(col=>{const f=fields(d).find(f=>f.column===col),label=f?.label||(ws?columnLabel(ws,Number(d.headerRow)-1,colNumber(col)):col);return `<label data-pbd-field-col="${col}"><input type="checkbox" ${f?'checked':''}><b>${col}</b><input type="text" value="${esc(label)}" maxlength="160" aria-label="Nama bidang lajur ${col}"></label>`;}).join('')}</div>${ws?`<details class="pbd-preview"><summary>Pratonton ${esc(d.sheetName)} (baris 1–${Math.min(24,Number(d.startRow)+3)})</summary><div class="pbd-table-wrap"><table><thead><tr><th>Baris</th>${cols.map(col=>'<th>'+col+'</th>').join('')}</tr></thead><tbody>${Array.from({length:Math.min(24,Number(d.startRow)+3)},(_,r)=>`<tr><th>${r+1}</th>${cols.map(col=>'<td>'+esc(readCell(ws,r,colNumber(col)).slice(0,140))+'</td>').join('')}</tr>`).join('')}</tbody></table></div></details>`:'<p class="pbd-note">Masukkan semula fail asal jika hendak melihat pratonton atau menukar padanan sheet.</p>'}<details class="pbd-preview"><summary>Pernyataan TP keseluruhan mengikut DSKP (pilihan)</summary><p class="pbd-note">Salin pernyataan subjek / tahun ini daripada templat asal atau DSKP. Jika kosong, guru akan dirujuk kepada sumber asal.</p>${[1,2,3,4,5,6].map(n=>`<label class="pbd-block">TP ${n}<textarea id="pbd-tp-${n}" rows="2" maxlength="1800">${esc(d.statements?.['TP'+n]||'')}</textarea></label>`).join('')}</details><label class="pbd-confirm"><input id="pbd-template-confirm" type="checkbox" required> Saya telah menyemak fail, subjek, tahun dan lajur yang dipadankan.</label>`;
            };
            W.saveSubjectPBDSettings=async(e,id)=>{
                e.preventDefault();const st=W.PBDTemplateState;if(!admin()||st.busy||st.subjectId!==id)return;
                preserveConfigForm();const d=st.draft,sub=subject(id);if(!d?.sheetName||!sub)return W.showToast('Masukkan fail templat asal dahulu.','warning');
                if(!document.getElementById('pbd-template-confirm')?.checked)return W.showToast('Semak dan sahkan padanan templat dahulu.','warning');
                try{
                    const mapped=[d.nameCol,d.kidCol,d.overallCol,d.genderCol,d.ulasanCol,...fields(d).map(f=>f.column)].filter(Boolean);
                    if(!d.name?.trim()||![d.nameCol,d.kidCol,d.overallCol].every(Boolean)||new Set(mapped).size!==mapped.length||mapped.some(c=>colNumber(c)<0||colNumber(c)>colNumber(d.lastColumn))||fields(d).some(f=>!f.label)||new Set(fields(d).map(f=>f.label.toLowerCase())).size!==fields(d).length)throw Error('Pilih lajur berbeza untuk nama, MyKid, TP keseluruhan dan bidang. Nama bidang mesti unik.');
                    if(!Number.isInteger(d.headerRow)||!Number.isInteger(d.startRow)||d.headerRow<1||d.startRow<=d.headerRow||d.startRow>300)throw Error('Baris murid mesti selepas tajuk lajur.');
                    if(d.sourceUrl&&!url(d.sourceUrl))throw Error('Gunakan pautan sumber HTTPS yang sah.');
                    if(!st.bytes&&!W.getPBDTemplateBytes(d))throw Error('Fail asal belum tersedia. Masukkan semula fail.');
                    st.busy=true;const button=document.getElementById('pbd-template-save');if(button)button.disabled=true;
                    document.getElementById('pbd-config-year').disabled=true;document.getElementById('pbd-template-file').disabled=true;
                    const config=copy(d),progress=document.getElementById('pbd-template-progress');
                    if(st.bytes){
                        config.assetKey='pbdTemplate_'+Date.now().toString(36)+'_'+Math.random().toString(36).slice(2,9);
                        config.fileName=st.file.name;config.fileSize=st.bytes.length;config.mimeType=/\.xlsm$/i.test(st.file.name)?'application/vnd.ms-excel.sheet.macroEnabled.12':/\.xls$/i.test(st.file.name)?'application/vnd.ms-excel':'application/vnd.openxmlformats-officedocument.spreadsheetml.sheet';
                    let encoded='';for(let i=0;i<st.bytes.length;i+=16384)encoded+=String.fromCharCode(...st.bytes.subarray(i,i+16384));encoded=btoa(encoded);
                        config.chunkCount=Math.ceil(encoded.length/36000);
                        for(let i=0;i<config.chunkCount;i++){
                            progress.textContent='Menyimpan fail asal '+(i+1)+' / '+config.chunkCount+'…';
                            const chunkId=config.assetKey+'_'+i,payload={settingKey:'PBD_TEMPLATE_ASSET',settingValue:encoded.slice(i*36000,(i+1)*36000),subjectId:id,yearLevel:Number(st.year),updatedAt:Date.now()};
                            await W.setFirestoreDoc('systemSettings',chunkId,payload,{merge:false});
                            const local=db().systemSettings.find(r=>r.id===chunkId);if(local)Object.assign(local,payload);else db().systemSettings.push({id:chunkId,...payload});
                        }
                    }
                    config.yearLevel=Number(st.year);config.subjectId=id;config.sourceUrl=url(d.sourceUrl);config.overallLabel=st.workbook?columnLabel(st.workbook.Sheets[d.sheetName],d.headerRow-1,colNumber(d.overallCol)):d.overallLabel||'TP Keseluruhan';config.confirmedBy=W.AppState.userId;config.updatedAt=Date.now();
                    const templates={...copy(sub.pbdTemplates),['Y'+st.year]:config},statements={...copy(sub.pbdStatements),['Y'+st.year]:copy(config.statements)};
                    if(JSON.stringify(templates).length>42000)throw Error('Tetapan subjek terlalu panjang. Ringkaskan pernyataan TP.');
                    progress.textContent='Menyimpan padanan subjek / tahun…';
                    await W.updateFirestoreDoc('subjects',id,{pbdTemplates:templates,pbdStatements:statements,updatedAt:Date.now()});Object.assign(sub,{pbdTemplates:templates,pbdStatements:statements});
                    W._pbdDraftKey='';W.closeModal();W.showToast('Templat Tahun '+st.year+' disimpan. Guru boleh mengisi bidang subjek ini.','success');W.renderContent(W.AppState.currentPath);
                }catch(error){W.showToast('Tetapan belum disimpan: '+error.message,'error');}
                finally{st.busy=false;for(const name of ['pbd-template-save','pbd-config-year','pbd-template-file']){const element=document.getElementById(name);if(element)element.disabled=false;}}
            };
            // Export is a transfer table, clearly distinguished from the unmodified original.
            W.buildPBDTransferWorkbook=()=>{
                const c=W.pbdContext();if(!c?.config)throw Error('Templat belum ditetapkan.');
                initializeDraft(c);const cfg=c.config,last=colNumber(cfg.lastColumn),rows=[Array.from({length:last+1},()=>'' )];
                const set=(row,col,value)=>{if(col)row[colNumber(col)]=value;};
                set(rows[0],cfg.nameCol,'NAMA MURID');set(rows[0],cfg.kidCol,'NO. MYKID');set(rows[0],cfg.genderCol,'JANTINA');set(rows[0],cfg.overallCol,cfg.overallLabel||'TP KESELURUHAN');set(rows[0],cfg.ulasanCol,'ULASAN GURU');fields(cfg).forEach(f=>set(rows[0],f.column,f.label));
                for(const s of c.students){const d=W.CurrentPBD[s.myKid],row=Array.from({length:last+1},()=>'' );set(row,cfg.nameCol,s.fullName);set(row,cfg.kidCol,String(s.myKid));set(row,cfg.genderCol,s.gender||'');set(row,cfg.overallCol,d.tp?Number(d.tp.slice(2)):'');set(row,cfg.ulasanCol,d.ulasan||'');fields(cfg).forEach(f=>set(row,f.column,d.domainTP?.[f.key]?Number(d.domainTP[f.key].slice(2)):''));rows.push(row);}
                const wb=XLSX.utils.book_new(),sheet=XLSX.utils.aoa_to_sheet(rows);sheet['!cols']=rows[0].map((_,i)=>({wch:colName(i)===cfg.nameCol?35:colName(i)===cfg.kidCol?18:24}));XLSX.utils.book_append_sheet(wb,sheet,'DATA UNTUK SALIN');
                XLSX.utils.book_append_sheet(wb,XLSX.utils.aoa_to_sheet([['Sesi',c.session.name],['Kelas',c.cls.name],['Subjek',c.sub.name],['Tahun',c.cls.yearLevel],['Fail asal',cfg.fileName],['Sheet sasaran',cfg.sheetName],['Baris murid pertama',cfg.startRow],['Tujuan','Data untuk disalin ke templat asal; bukan fail templat rasmi KPM.'],['Cara','Salin nilai murid ke lajur sepadan dalam fail asal. Kekalkan formula, graf, validasi dan format asal.']]),'PANDUAN SALIN');
                XLSX.utils.book_append_sheet(wb,XLSX.utils.aoa_to_sheet([['MATTARY_PBD_TRANSFER_V17',c.session.id,c.cls.id,c.sub.id,c.cls.yearLevel,cfg.assetKey]]),'_MATTARY');
                return wb;
            };
            W.exportPBDTransferData=()=>{try{const c=W.pbdContext(),wb=W.buildPBDTransferWorkbook();XLSX.writeFile(wb,'DATA_PBD_'+String(c.sub.code||c.sub.name).replace(/[^a-z0-9_-]/gi,'_')+'_TAHUN_'+c.cls.yearLevel+'_'+String(c.cls.name).replace(/[^a-z0-9_-]/gi,'_')+'.xlsx');}catch(e){W.showToast(e.message,'warning');}};
            W.parseFilledPBD=wb=>{
                const c=W.pbdContext();if(!c?.config)throw Error('Tetapkan templat dahulu.');
                const cfg=c.config,transfer=wb.Sheets['_MATTARY'];let sheet,start;
                if(transfer){
                    const meta=XLSX.utils.sheet_to_json(transfer,{header:1,defval:''})[0]||[];
                    if(meta[0]!=='MATTARY_PBD_TRANSFER_V17'||meta[1]!==c.session.id||meta[2]!==c.cls.id||meta[3]!==c.sub.id||Number(meta[4])!==Number(c.cls.yearLevel)||meta[5]!==cfg.assetKey)throw Error('Fail data bukan untuk sesi, kelas, subjek atau versi templat ini.');
                    sheet=wb.Sheets['DATA UNTUK SALIN'];start=1;
                }else{sheet=wb.Sheets[cfg.sheetName];start=cfg.startRow-1;}
                if(!sheet)throw Error('Sheet rekod yang dipadankan tidak dijumpai.');
                const range=XLSX.utils.decode_range(sheet['!ref']||'A1'),allowed=new Map(c.students.map(s=>[String(s.myKid),s])),seen=new Set(),changes=[];let ignored=0;
                const value=(r,col)=>col?sheet[XLSX.utils.encode_cell({r,c:colNumber(col)})]?.v??'':'';
                for(let r=start;r<=Math.min(range.e.r,9999);r++){
                    let kid=String(value(r,cfg.kidCol)).trim().replace(/[\s-]/g,'');if(!kid)continue;
                    if(/^\d{1,11}$/.test(kid))kid=kid.padStart(12,'0');
                    if(!allowed.has(kid)){ignored++;continue;}if(seen.has(kid))throw Error('MyKid berulang pada baris '+(r+1)+'.');seen.add(kid);
                    const raw=value(r,cfg.overallCol),tp=normalizeTP(raw),domainTP={};if(String(raw).trim()&&!tp)throw Error('TP keseluruhan tidak sah pada baris '+(r+1)+'.');
                    for(const f of fields(cfg)){const v=value(r,f.column),t=normalizeTP(v);if(String(v).trim()&&!t)throw Error('TP '+f.label+' tidak sah pada baris '+(r+1)+'.');if(t)domainTP[f.key]=t;}
                    // Completely empty template rows never clear an existing assessment.
                    if(!tp&&!Object.values(domainTP).some(validTP)&&!String(value(r,cfg.ulasanCol)).trim())continue;
                    const old=W.CurrentPBD[kid]||latestRecord(c,kid)||{};
                    changes.push({myKid:kid,name:allowed.get(kid).fullName,tp:tp||old.tp||'',domainTP,ulasan:String(value(r,cfg.ulasanCol)||old.ulasan||'')});
                }
                if(!changes.length)throw Error('Tiada TP sah bagi murid kelas ini. Semak padanan lajur dan MyKid.');
                return {contextKey:[c.session.id,c.cls.id,c.sub.id,cfg.assetKey].join('|'),changes,ignored};
            };
            W.importFilledPBD=async file=>{
                if(!file)return;
                try{
                    if(file.size>5*1024*1024||! /\.(xlsx|xlsm|xls)$/i.test(file.name))throw Error('Pilih fail Excel PBD sehingga 5 MB.');
                    const wb=XLSX.read(await file.arrayBuffer(),{type:'array'}),preview=W.parseFilledPBD(wb);W._pbdImportPreview=preview;
                    W.openModal('Semak Import PBD',`<div class="pbd17"><p class="pbd-note">${preview.changes.length} murid dipadankan melalui MyKid. ${preview.ignored} baris di luar kelas diabaikan. Sel kosong mengekalkan nilai sedia ada. Semak nama, subjek dan tahun sebelum gunakan data; tekan Simpan Semua selepas itu.</p><div class="pbd-table-wrap"><table><thead><tr><th>Nama</th><th>MyKid</th><th>TP Keseluruhan</th></tr></thead><tbody>${preview.changes.map(x=>`<tr><td>${esc(x.name)}</td><td>${esc(x.myKid)}</td><td>${esc(x.tp||'—')}</td></tr>`).join('')}</tbody></table></div><div class="pbd-actions"><button onclick="window.closeModal()">Batal</button><button id="pbd-apply-import" onclick="window.applyPBDImport()">Gunakan Data Import</button></div></div>`);
                }catch(e){W.showToast('Import dibatalkan: '+e.message,'error');}
            };
            W.applyPBDImport=()=>{
                const c=W.pbdContext(),p=W._pbdImportPreview;if(!c?.config||!p||p.contextKey!==[c.session.id,c.cls.id,c.sub.id,c.config.assetKey].join('|'))return W.showToast('Pilihan kelas / subjek telah berubah. Import semula fail.','warning');
                initializeDraft(c);for(const r of p.changes)W.CurrentPBD[r.myKid]={tp:r.tp,ulasan:r.ulasan,domainTP:{...W.CurrentPBD[r.myKid].domainTP,...r.domainTP}};
                W._pbdDirty=true;W._pbdImportPreview=null;W.closeModal();W.renderContent(W.AppState.currentPath);W.showToast('Data import dimasukkan. Tekan Simpan Semua untuk menyimpan.','success');
            };
        })(window);

    </script>
