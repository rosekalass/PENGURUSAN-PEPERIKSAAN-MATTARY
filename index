        window.subjectAppliesToYear = function(subject, yearLevel) {
            const raw = subject?.yearLevel;
            if (raw === null || raw === undefined || raw === '' || String(raw).toUpperCase() === 'SEMUA') return true;
            if (Array.isArray(raw)) return raw.some(v => String(v).toUpperCase() === 'SEMUA' || Number(v) === Number(yearLevel));
            const parts = String(raw).split(/[,;/|]/).map(v => v.trim()).filter(Boolean);
            return parts.some(v => v.toUpperCase() === 'SEMUA' || Number(v) === Number(yearLevel));
        };

