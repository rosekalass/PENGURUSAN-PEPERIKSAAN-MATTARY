        window.saveAllMarks = async () => {
            const actSession = window.DBHelpers.getActiveSession();
            if (!actSession) return window.showToast('Sesi tidak aktif.', 'error');
            
            const { classId, subjectId, examType, category } = window.AssessmentState;
            if (!classId || !subjectId) return window.showToast('Pilih kelas dan subjek dahulu.', 'warning');

            window.AssessmentState.saving = true;
            const btn = document.getElementById('btn-save-marks'); 
            if(btn) btn.innerHTML = '<i class="fa-solid fa-spinner fa-spin"></i> Menyimpan...';
            
            const colName = category === 'AKADEMIK' ? 'academicMarks' : 'hafazanMarks';

            try {
                let addCount = 0; let updateCount = 0;
                for (const [myKid, data] of Object.entries(window.CurrentMarks)) {
                    if (!data.status) continue; 
                    const existing = window.LocalDB[colName].find(m => m.myKid === myKid && m.classId === classId && m.subjectId === subjectId && m.examType === examType && m.sessionId === actSession.id);
                    
                    let percentage = null; let grade = null;
                    if (data.status === 'HADIR' && data.mark !== null && data.mark !== '') {
                        percentage = Number(data.mark);
                        grade = window.getGradeFromPercentage(percentage).grade;
                    }

                    const payload = { myKid, subjectId, sessionId: actSession.id, classId, examType, category, status: data.status, mark: data.mark, percentage, grade, updatedAt: Date.now() };
                    if (existing) { await window.updateFirestoreDoc(colName, existing.id, payload); updateCount++; }
                    else { await window.addFirestoreDoc(colName, { ...payload, createdAt: Date.now() }); addCount++; }
                }
                window.showToast(`Berjaya! ${addCount} ditambah, ${updateCount} dikemaskini.`, 'success');
            } catch (err) {
                console.error("[Save Marks Error]", err); window.showToast('Ralat menyimpan markah.', 'error');
            } finally {
                window.AssessmentState.saving = false; if(btn) btn.innerHTML = '<i class="fa-solid fa-cloud-arrow-up"></i> Simpan Semua';
                window.renderContent(window.AppState.currentPath);
