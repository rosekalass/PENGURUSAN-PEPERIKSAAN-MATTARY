                            </select>
                        </div>
                    </div>
                </div>
            `;

            if (window.PBDState.classId && window.PBDState.subjectId) {
                const students = window.DBHelpers.getStudentsForSession(actSession.id).filter(s => s.classId === window.PBDState.classId && s.activeStatus).sort((a,b)=>a.fullName.localeCompare(b.fullName));
