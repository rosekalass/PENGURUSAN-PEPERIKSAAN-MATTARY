        window.togglePublication = async (examType, isPublished) => {
            const actSession = window.DBHelpers.getActiveSession(); if(!actSession) return;
            const newStatus = isPublished ? 'DRAFT' : 'PUBLISHED';
            const actionText = isPublished ? 'menarik balik' : 'menerbitkan';
            
            window.showConfirmModal('Pengesahan Penerbitan', `Adakah anda pasti mahu ${actionText} keputusan ${examType.replace('_',' ')}?`, async () => {
                try {
                    const existing = window.LocalDB.publications.find(p => p.examType === examType && p.sessionId === actSession.id);
                    if (existing) await window.updateFirestoreDoc('publications', existing.id, { status: newStatus, updatedAt: Date.now() });
                    else await window.addFirestoreDoc('publications', { examType, sessionId: actSession.id, status: newStatus, createdAt: Date.now() });
                    window.showToast(`Status ditukar kepada ${newStatus}.`, 'success');
                } catch(e) { window.showToast('Ralat mengemaskini status.', 'error'); }
            });
        };

